#!/usr/bin/env bash
# Build release binaries for Apple Silicon and Intel, then lipo a universal binary.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

export MACOSX_DEPLOYMENT_TARGET="${MACOSX_DEPLOYMENT_TARGET:-12.0}"
export PATH="${HOME}/.cargo/bin:${PATH}"

if ! command -v cargo >/dev/null 2>&1; then
  echo "error: cargo not found. Install Rust from https://rustup.rs and run: source \"\$HOME/.cargo/env\"" >&2
  exit 1
fi

logical_cpus() {
  sysctl -n hw.logicalcpu 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4
}

TOTAL_JOBS="${CARGO_BUILD_JOBS:-$(logical_cpus)}"
TARGET_BUILD_JOBS="${CARGO_TARGET_JOBS:-$(((TOTAL_JOBS + 1) / 2))}"
if (( TARGET_BUILD_JOBS < 1 )); then
  TARGET_BUILD_JOBS=1
fi

rustup target add aarch64-apple-darwin x86_64-apple-darwin 2>/dev/null || true

LOG_DIR="target/build-logs"
mkdir -p "$LOG_DIR"

build_target() {
  local target="$1"
  local log="$LOG_DIR/${target}.log"
  echo "Building ${target} (release, cargo jobs=${TARGET_BUILD_JOBS})..."
  cargo build --release --target "$target" --jobs "$TARGET_BUILD_JOBS" >"$log" 2>&1
}

build_target aarch64-apple-darwin &
ARM_PID=$!
build_target x86_64-apple-darwin &
INTEL_PID=$!

ARM_STATUS=0
INTEL_STATUS=0
wait "$ARM_PID" || ARM_STATUS=$?
wait "$INTEL_PID" || INTEL_STATUS=$?

if (( ARM_STATUS != 0 || INTEL_STATUS != 0 )); then
  echo "error: one or more release builds failed" >&2
  if (( ARM_STATUS != 0 )); then
    echo "---- aarch64-apple-darwin log ----" >&2
    sed -n '1,200p' "$LOG_DIR/aarch64-apple-darwin.log" >&2
  fi
  if (( INTEL_STATUS != 0 )); then
    echo "---- x86_64-apple-darwin log ----" >&2
    sed -n '1,200p' "$LOG_DIR/x86_64-apple-darwin.log" >&2
  fi
  exit 1
fi

echo "Finished aarch64-apple-darwin and x86_64-apple-darwin release builds."

ARM="target/aarch64-apple-darwin/release/rusty-jack"
INTEL="target/x86_64-apple-darwin/release/rusty-jack"
UNI="target/release/rusty-jack-universal"

mkdir -p target/release
lipo -create "$ARM" "$INTEL" -output "$UNI"

echo "Universal binary: $UNI"
file "$ARM" "$INTEL" "$UNI"
