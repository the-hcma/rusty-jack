#!/usr/bin/env bash
# Open or update the Release Please release PR using the caller's gh auth token.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

# shellcheck source=release-lib
source "${ROOT}/scripts/release-lib"

REPO="${RUSTY_JACK_REPO:-the-hcma/rusty-jack}"
DRY_RUN=0

usage() {
  cat <<'EOF'
Usage: update-release-pr [--dry-run]

Open or update the Release Please PR on GitHub (version bump + CHANGELOG).

Run from main after merging releasable commits (the script fast-forwards main when behind origin).

Options:
  --dry-run    Print checks without calling release-please.
  -h, --help   Show this help.

Environment:
  RUSTY_JACK_RELEASE_PR_LOOKUP_ATTEMPTS      Retries finding release PR (default: 8)
  RUSTY_JACK_RELEASE_PR_LOOKUP_INTERVAL_SECS Seconds between lookups (default: 5)

See docs/RELEASING.md for the full release flow.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "error: unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

release_lib_require_cmd gh
release_lib_require_cmd git
release_lib_load_token

release_lib_ensure_synced_main "${DRY_RUN}"

release_lib_publish_pending_release_if_needed "${REPO}" "${DRY_RUN}" "${ROOT}"

release_lib_print_release_pr_url_line() {
  local pr_url
  pr_url="$(release_lib_resolve_release_pr_url "${REPO}" "${RELEASE_LIB_RELEASE_PLEASE_OUTPUT:-}")"
  if [[ -n "${pr_url}" ]]; then
    echo "${pr_url}"
  elif [[ "${DRY_RUN}" -eq 1 ]]; then
    echo "[dry-run] no open release-please PR found"
  else
    echo "No open release-please PR found."
  fi
}

if [[ "${DRY_RUN}" -eq 1 ]]; then
  echo "[dry-run] would verify write access to ${REPO}"
  echo "[dry-run] would run: npx release-please release-pr --repo-url=${REPO}"
  release_lib_print_release_pr_url_line
  exit 0
fi

release_lib_verify_repo_access "${REPO}"
echo "Updating release PR for ${REPO}..."
RELEASE_LIB_RELEASE_PLEASE_OUTPUT=""
if ! release_lib_run_release_please release-pr "${REPO}"; then
  echo "error: release-please release-pr failed" >&2
  exit 1
fi
echo "Done. Review the release-please PR on GitHub, then merge it before running make publish-release."
release_lib_print_release_pr_url_line
