#!/usr/bin/env bash
# Publish a Rusty Jack release and open the Homebrew tap update PR.
#
# Uses the caller's GitHub credentials (GH_TOKEN or `gh auth token`). Run from
# an up-to-date main checkout after the Release Please PR has merged.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

# shellcheck source=release-lib
source "${ROOT}/scripts/release-lib"

REPO="${RUSTY_JACK_REPO:-the-hcma/rusty-jack}"
TAP_REPO="${RUSTY_JACK_TAP_REPO:-the-hcma/homebrew-tap}"
TAP_ONLY=0
DRY_RUN=0

usage() {
  cat <<'EOF'
Usage: publish-release [--tap-only] [--dry-run]

Publish the current Cargo.toml version to GitHub and update the Homebrew tap.

Options:
  --tap-only   Skip GitHub release creation; update the tap formula only.
  --dry-run    Print actions without changing GitHub or the tap.
  -h, --help   Show this help.

Environment:
  GH_TOKEN              GitHub token (defaults to `gh auth token`)
  RUSTY_JACK_REPO       Source repository (default: the-hcma/rusty-jack)
  RUSTY_JACK_TAP_REPO   Homebrew tap repository (default: the-hcma/homebrew-tap)

Requires: gh, curl, git, make, and npx (Node.js) for release-please.

See docs/RELEASING.md for the full release flow.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --tap-only)
      TAP_ONLY=1
      shift
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "error: unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

release_lib_require_cmd gh
release_lib_require_cmd curl
release_lib_require_cmd git
release_lib_require_cmd make
release_lib_load_token

release_lib_ensure_synced_main "${DRY_RUN}"

VERSION="$(release_lib_cargo_version)"
if [[ -z "${VERSION}" ]]; then
  echo "error: could not read package version from Cargo.toml" >&2
  exit 1
fi

TAG=""
ARCHIVE_URL=""
TAP_BRANCH="rusty-jack-v${VERSION}"

echo "Repository: ${REPO}"
echo "Tap:        ${TAP_REPO}"
echo "Version:    ${VERSION}"

if [[ "${DRY_RUN}" -eq 1 ]]; then
  echo "[dry-run] release tag candidates: rusty-jack-v${VERSION}, v${VERSION}"
else
  if resolved="$(release_lib_resolve_release_tag "${REPO}" "${VERSION}")"; then
    TAG="${resolved}"
    ARCHIVE_URL="https://github.com/${REPO}/archive/refs/tags/${TAG}.tar.gz"
    echo "Release tag: ${TAG}"
  elif [[ "${TAP_ONLY}" -eq 1 ]]; then
    echo "error: no GitHub release found for version ${VERSION}" >&2
    exit 1
  fi
fi

if [[ "${DRY_RUN}" -eq 1 ]]; then
  echo "[dry-run] would verify GitHub access to ${REPO} and ${TAP_REPO}"
else
  release_lib_verify_repo_access "${REPO}"
  release_lib_verify_repo_access "${TAP_REPO}"
fi

publish_github_release() {
  if resolved="$(release_lib_resolve_release_tag "${REPO}" "${VERSION}")"; then
    TAG="${resolved}"
    ARCHIVE_URL="https://github.com/${REPO}/archive/refs/tags/${TAG}.tar.gz"
    echo "GitHub release ${TAG} already exists"
    return 0
  fi

  if [[ "${DRY_RUN}" -eq 1 ]]; then
    echo "[dry-run] would run: npx release-please github-release --repo-url=${REPO}"
    return 0
  fi

  release_lib_run_release_please github-release "${REPO}"

  if ! TAG="$(release_lib_resolve_release_tag "${REPO}" "${VERSION}")"; then
    echo "release-please had no pending release; creating GitHub release via gh fallback..."
    release_lib_create_github_release_fallback "${REPO}" "${VERSION}"
    TAG="$(release_lib_resolve_release_tag "${REPO}" "${VERSION}")"
  fi

  if [[ -z "${TAG}" ]]; then
    echo "error: could not create GitHub release for version ${VERSION}" >&2
    exit 1
  fi
  ARCHIVE_URL="https://github.com/${REPO}/archive/refs/tags/${TAG}.tar.gz"
  echo "Created GitHub release ${TAG}"
}

compute_archive_sha256() {
  local archive_path="$1"
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "${archive_path}" | awk '{print $1}'
  else
    sha256sum "${archive_path}" | awk '{print $1}'
  fi
}

clone_tap_repo() {
  local dest="$1"
  git clone --depth=1 "https://github.com/${TAP_REPO}.git" "${dest}"
}

update_homebrew_tap() {
  local archive_sha256 body tap_dir

  if [[ "${DRY_RUN}" -eq 1 ]]; then
    echo "[dry-run] would download archive for rusty-jack-v${VERSION} or v${VERSION}"
    echo "[dry-run] would render Formula/rusty-jack.rb and open tap PR ${TAP_BRANCH}"
    return 0
  fi

  if [[ -z "${TAG}" ]] && ! TAG="$(release_lib_resolve_release_tag "${REPO}" "${VERSION}")"; then
    echo "error: GitHub release for version ${VERSION} does not exist; run without --tap-only first" >&2
    exit 1
  fi
  ARCHIVE_URL="https://github.com/${REPO}/archive/refs/tags/${TAG}.tar.gz"

  local archive_path
  archive_path="$(mktemp -t rusty-jack-source.XXXXXX.tar.gz)"
  tap_dir="$(mktemp -d -t rusty-jack-tap.XXXXXX)"

  curl -fsSL --retry 6 --retry-delay 5 "${ARCHIVE_URL}" -o "${archive_path}"
  archive_sha256="$(compute_archive_sha256 "${archive_path}")"

  clone_tap_repo "${tap_dir}"
  mkdir -p "${tap_dir}/Formula"
  git_commit="$(git rev-parse --short "${TAG}" 2>/dev/null || git rev-parse --short HEAD)"
  make render-homebrew-formula \
    ARCHIVE_URL="${ARCHIVE_URL}" \
    ARCHIVE_SHA256="${archive_sha256}" \
    GIT_COMMIT="${git_commit}" \
    >"${tap_dir}/Formula/rusty-jack.rb"
  if ! head -n1 "${tap_dir}/Formula/rusty-jack.rb" | grep -q '^class RustyJack'; then
    echo "error: rendered formula does not look like valid Ruby; check make render-homebrew-formula" >&2
    head -n5 "${tap_dir}/Formula/rusty-jack.rb" >&2
    exit 1
  fi

  (
    cd "${tap_dir}"
    release_lib_configure_git_identity
    git checkout -B "${TAP_BRANCH}"
    git add Formula/rusty-jack.rb
    if git diff --cached --quiet; then
      echo "Homebrew formula already current for ${TAG}"
      exit 0
    fi
    git commit -m "rusty-jack ${TAG}"
    git push --force origin "${TAP_BRANCH}"
  )

  rm -rf "${tap_dir}" "${archive_path}"

  body="$(cat <<EOF
## Summary
- Update the Rusty Jack formula for ${TAG}.

## Test plan
- \`make publish-release\` generated formula
EOF
)"

  release_lib_open_tap_pr "${TAP_REPO}" "${TAP_BRANCH}" "rusty-jack ${TAG}" "${body}"
  echo "Opened tap update PR for ${TAG} (auto-merge enabled)"
}

if [[ "${TAP_ONLY}" -eq 0 ]]; then
  publish_github_release
fi

update_homebrew_tap

echo "Done."
