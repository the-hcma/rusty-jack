#!/usr/bin/env bash
# Shared helpers for local Release Please automation.
set -euo pipefail

release_lib_require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "error: required command not found: $1" >&2
    exit 1
  fi
}

release_lib_load_token() {
  GH_TOKEN="${GH_TOKEN:-$(gh auth token)}"
  export GH_TOKEN
}

release_lib_cargo_version() {
  awk -F'"' '/^version = / { print $2; exit }' Cargo.toml
}

release_lib_ensure_synced_main() {
  local dry_run="${1:-0}"

  if [[ "${dry_run}" -eq 1 ]]; then
    echo "[dry-run] would fetch origin/main and fast-forward main when behind origin"
    return 0
  fi

  local branch
  branch="$(git rev-parse --abbrev-ref HEAD)"
  if [[ "${branch}" != "main" ]]; then
    echo "error: must run from main (current branch: ${branch})" >&2
    exit 1
  fi

  if ! git diff --quiet || ! git diff --cached --quiet; then
    echo "error: working tree must be clean" >&2
    exit 1
  fi

  git fetch origin main

  local local_sha remote_sha
  local_sha="$(git rev-parse HEAD)"
  remote_sha="$(git rev-parse origin/main)"
  if [[ "${local_sha}" == "${remote_sha}" ]]; then
    echo "main is up to date with origin/main (${local_sha:0:7})"
    return 0
  fi

  if git merge-base --is-ancestor "${local_sha}" "${remote_sha}"; then
    echo "main is behind origin/main; fast-forwarding..."
    git merge --ff-only origin/main
    local_sha="$(git rev-parse HEAD)"
    echo "main is up to date with origin/main (${local_sha:0:7})"
    return 0
  fi

  if git merge-base --is-ancestor "${remote_sha}" "${local_sha}"; then
    echo "main is ahead of origin/main (${local_sha:0:7}); continuing"
    return 0
  fi

  echo "error: main has diverged from origin/main" >&2
  echo "  local:  ${local_sha}" >&2
  echo "  remote: ${remote_sha}" >&2
  echo "Run: git pull --rebase origin main (or reset/rebase manually)" >&2
  exit 1
}

release_lib_verify_repo_access() {
  local repo="$1"
  gh api "repos/${repo}" --jq .full_name >/dev/null
}

# Populated by release_lib_run_release_please (stdout+stderr).
RELEASE_LIB_RELEASE_PLEASE_OUTPUT=""

release_lib_run_release_please() {
  local subcommand="$1"
  local repo="$2"
  local output rc

  release_lib_require_cmd npx
  set +e
  output="$(
    npx --yes release-please@latest "${subcommand}" \
      --token="${GH_TOKEN}" \
      --repo-url="${repo}" \
      --config-file=release-please-config.json \
      --manifest-file=.release-please-manifest.json 2>&1
  )"
  rc=$?
  set -e
  RELEASE_LIB_RELEASE_PLEASE_OUTPUT="${output}"
  printf '%s\n' "${output}"
  return "${rc}"
}

release_lib_parse_release_please_pr_numbers() {
  local output="$1"
  local bracket numbers

  bracket="$(printf '%s\n' "${output}" | grep -oE '\[[0-9, ]+\]' | tail -n1 || true)"
  if [[ -z "${bracket}" ]]; then
    return 0
  fi
  numbers="${bracket//[\[\]]/}"
  numbers="${numbers//,/ }"
  for number in ${numbers}; do
    if [[ "${number}" =~ ^[0-9]+$ ]]; then
      echo "${number}"
    fi
  done
}

release_lib_pr_url_from_number() {
  local repo="$1"
  local number="$2"

  gh pr view "${number}" --repo "${repo}" --json url --jq .url 2>/dev/null || true
}

release_lib_resolve_release_tag() {
  local repo="$1"
  local version="$2"
  local candidate

  for candidate in "rusty-jack-v${version}" "v${version}"; do
    if gh release view "${candidate}" --repo "${repo}" >/dev/null 2>&1; then
      echo "${candidate}"
      return 0
    fi
  done
  return 1
}

release_lib_primary_release_tag() {
  echo "rusty-jack-v${1}"
}

# Print version|pr_number|pr_url when a merged release PR exists but GitHub has no tag.
release_lib_find_unpublished_release() {
  local repo="$1"
  local version pr_number pr_url

  version="$(release_lib_cargo_version)"
  if [[ -z "${version}" ]]; then
    return 1
  fi

  if release_lib_resolve_release_tag "${repo}" "${version}" >/dev/null 2>&1; then
    return 1
  fi

  pr_number="$(gh pr list --repo "${repo}" --state merged \
    --search "release rusty-jack ${version} in:title" \
    --json number --jq '.[0].number // empty')"
  if [[ -z "${pr_number}" ]]; then
    return 1
  fi

  pr_url="$(gh pr view "${pr_number}" --repo "${repo}" --json url --jq .url)"
  printf '%s|%s|%s' "${version}" "${pr_number}" "${pr_url}"
}

# Return URL of the open release-please PR, or empty when none exists.
release_lib_open_release_pr_url() {
  local repo="$1"
  local pr_url search

  pr_url="$(gh pr list --repo "${repo}" --state open --label release-please \
    --json url --jq '.[0].url // empty' 2>/dev/null || true)"
  if [[ -n "${pr_url}" ]]; then
    echo "${pr_url}"
    return 0
  fi

  pr_url="$(gh pr list --repo "${repo}" --state open --label "autorelease: pending" \
    --json url --jq '.[0].url // empty' 2>/dev/null || true)"
  if [[ -n "${pr_url}" ]]; then
    echo "${pr_url}"
    return 0
  fi

  pr_url="$(gh pr list --repo "${repo}" --state open --head "release-please--branches--main" \
    --json url --jq '.[0].url // empty' 2>/dev/null || true)"
  if [[ -n "${pr_url}" ]]; then
    echo "${pr_url}"
    return 0
  fi

  for search in \
    "release rusty-jack in:title" \
    "chore(main): release rusty-jack in:title" \
    "chore: release rusty-jack in:title" \
    "chore(main): release in:title"; do
    pr_url="$(gh pr list --repo "${repo}" --state open --search "${search}" \
      --json url --jq '.[0].url // empty' 2>/dev/null || true)"
    if [[ -n "${pr_url}" ]]; then
      echo "${pr_url}"
      return 0
    fi
  done

  echo ""
}

release_lib_open_release_pr_url_with_retry() {
  local repo="$1"
  local attempts="${2:-${RUSTY_JACK_RELEASE_PR_LOOKUP_ATTEMPTS:-8}}"
  local interval="${3:-${RUSTY_JACK_RELEASE_PR_LOOKUP_INTERVAL_SECS:-5}}"
  local attempt pr_url

  for ((attempt = 1; attempt <= attempts; attempt++)); do
    pr_url="$(release_lib_open_release_pr_url "${repo}")"
    if [[ -n "${pr_url}" ]]; then
      echo "${pr_url}"
      return 0
    fi
    if (( attempt < attempts )); then
      echo "Waiting for release PR to appear (${attempt}/${attempts})..." >&2
      sleep "${interval}"
    fi
  done

  echo ""
  return 1
}

# Prefer PR numbers printed by release-please, then retry GitHub lookups.
release_lib_resolve_release_pr_url() {
  local repo="$1"
  local release_please_output="${2:-}"
  local number pr_url

  for number in $(release_lib_parse_release_please_pr_numbers "${release_please_output}"); do
    pr_url="$(release_lib_pr_url_from_number "${repo}" "${number}")"
    if [[ -n "${pr_url}" ]]; then
      echo "${pr_url}"
      return 0
    fi
  done

  release_lib_open_release_pr_url_with_retry "${repo}" || true
}

release_lib_publish_pending_release_if_needed() {
  local repo="$1"
  local dry_run="${2:-0}"
  local root="$3"
  local unpublished version pr_number pr_url tag

  if ! unpublished="$(release_lib_find_unpublished_release "${repo}")"; then
    return 0
  fi

  IFS='|' read -r version pr_number pr_url <<<"${unpublished}"
  tag="$(release_lib_primary_release_tag "${version}")"

  if [[ "${dry_run}" -eq 1 ]]; then
    echo "[dry-run] would run: make publish-release (merged release PR #${pr_number} for ${version}, missing ${tag})"
    return 0
  fi

  echo "Merged release PR #${pr_number} for ${version} has no GitHub release (${tag})."
  echo "Publishing pending release before opening the next release PR..."
  echo "  ${pr_url}"
  "${root}/scripts/publish-release"
}

release_lib_find_release_merge_sha() {
  local repo="$1"
  local version="$2"
  gh pr list --repo "${repo}" --state merged --search "release rusty-jack ${version} in:title" \
    --json mergeCommit --jq '.[0].mergeCommit.oid // empty'
}

release_lib_changelog_notes_file() {
  local version="$1"
  local notes_file
  notes_file="$(mktemp -t rusty-jack-changelog.XXXXXX)"

  awk -v ver="${version}" '
    $0 ~ "^## \\[" ver "\\]" { found = 1 }
    found {
      if ($0 ~ /^## \[/ && $0 !~ "^## \\[" ver "\\]") exit
      print
    }
  ' CHANGELOG.md >"${notes_file}"

  if [[ ! -s "${notes_file}" ]]; then
    rm -f "${notes_file}"
    echo "error: no CHANGELOG.md section for version ${version}" >&2
    return 1
  fi

  echo "${notes_file}"
}

release_lib_create_github_release_fallback() {
  local repo="$1"
  local version="$2"
  local tag target_sha notes_file
  tag="$(release_lib_primary_release_tag "${version}")"
  target_sha="$(release_lib_find_release_merge_sha "${repo}" "${version}")"
  if [[ -z "${target_sha}" ]]; then
    echo "error: could not find merged release PR for version ${version}" >&2
    return 1
  fi

  notes_file="$(release_lib_changelog_notes_file "${version}")"
  gh release create "${tag}" --repo "${repo}" --target "${target_sha}" \
    --title "rusty-jack: v${version}" --notes-file "${notes_file}"
  rm -f "${notes_file}"
}

release_lib_configure_git_identity() {
  local name email user_id
  name="$(gh api user --jq .login)"
  email="$(gh api user --jq '.email // ""')"
  if [[ -z "${email}" ]]; then
    user_id="$(gh api user --jq .id)"
    email="${user_id}@users.noreply.github.com"
  fi
  git config user.name "${name}"
  git config user.email "${email}"
}

# Keep README.md static release badge in sync with Formula/rusty-jack.rb (homebrew-tap CI).
release_lib_update_tap_readme_badge() {
  local tap_dir="$1"
  local version="$2"
  local readme="${tap_dir}/README.md"
  local needle="rusty--jack-v${version}-blue"

  if [[ ! -f "${readme}" ]]; then
    echo "error: ${readme} not found in tap repo" >&2
    return 1
  fi
  if grep -qF "${needle}" "${readme}"; then
    return 0
  fi
  if ! grep -qE 'rusty--jack-v[0-9]+\.[0-9]+\.[0-9]+-blue' "${readme}"; then
    echo "error: ${readme} has no rusty-jack release badge to update" >&2
    return 1
  fi

  sed -E "s/rusty--jack-v[0-9]+\.[0-9]+\.[0-9]+-blue/rusty--jack-v${version}-blue/g" "${readme}" \
    >"${readme}.tmp"
  mv "${readme}.tmp" "${readme}"
}

release_lib_find_open_tap_pr_number() {
  local tap_repo="$1"
  local branch="$2"
  local attempts="${3:-${RUSTY_JACK_TAP_PR_LOOKUP_ATTEMPTS:-6}}"
  local interval="${4:-${RUSTY_JACK_TAP_PR_LOOKUP_INTERVAL_SECS:-5}}"
  local attempt pr_number

  for ((attempt = 1; attempt <= attempts; attempt++)); do
    pr_number="$(gh pr list --repo "${tap_repo}" --head "${branch}" --state open --json number \
      --jq '.[0].number // empty' 2>/dev/null || true)"
    if [[ -n "${pr_number}" ]]; then
      echo "${pr_number}"
      return 0
    fi
    if (( attempt < attempts )); then
      echo "Waiting for tap PR on branch ${branch} (${attempt}/${attempts})..." >&2
      sleep "${interval}"
    fi
  done

  return 1
}

release_lib_open_tap_pr() {
  local tap_repo="$1"
  local branch="$2"
  local title="$3"
  local body="$4"
  local pr_number pr_url

  pr_number="$(release_lib_find_open_tap_pr_number "${tap_repo}" "${branch}" 1 0 || true)"
  if [[ -n "${pr_number}" ]]; then
    gh pr edit "${pr_number}" --repo "${tap_repo}" --title "${title}" --body "${body}" >/dev/null
  else
    gh pr create --repo "${tap_repo}" --base main --head "${branch}" --title "${title}" --body "${body}" >/dev/null
    pr_number="$(release_lib_find_open_tap_pr_number "${tap_repo}" "${branch}")" || true
  fi
  if [[ -z "${pr_number}" ]]; then
    echo "error: could not find open tap PR for branch ${branch}" >&2
    return 1
  fi
  gh pr merge "${pr_number}" --repo "${tap_repo}" --squash --auto --delete-branch
  pr_url="$(gh pr view "${pr_number}" --repo "${tap_repo}" --json url --jq .url)"
  echo "${pr_url}"
}

# Return 0 when failed/cancelled checks should block waiting for merge.
release_lib_pr_checks_blocking_merge() {
  local repo="$1"
  local pr_number="$2"
  local pr_url="$3"
  local output rc

  set +e
  output="$(gh pr checks "${pr_number}" --repo "${repo}" --json name,bucket,link \
    --jq '[.[] | select(.bucket == "fail" or .bucket == "cancel")] | length' 2>&1)"
  rc=$?
  set -e

  if [[ "${rc}" -ne 0 ]]; then
    if echo "${output}" | grep -qi "no checks reported"; then
      return 1
    fi
    return 1
  fi

  if [[ -z "${output}" || "${output}" == "0" ]]; then
    return 1
  fi

  echo "error: PR checks failed; auto-merge will not run: ${pr_url}" >&2
  gh pr checks "${pr_number}" --repo "${repo}" --json name,bucket,link \
    --jq '.[] | select(.bucket == "fail" or .bucket == "cancel") | "  \(.name): \(.link)"' >&2
  return 0
}

release_lib_wait_for_tap_pr_checks() {
  local tap_repo="$1"
  local pr_number="$2"
  local pr_url="$3"
  local attempts="${4:-${RUSTY_JACK_TAP_CHECKS_ATTEMPTS:-3}}"
  local interval="${5:-10}"
  local attempt output rc

  for ((attempt = 1; attempt <= attempts; attempt++)); do
    set +e
    output="$(gh pr checks "${pr_number}" --repo "${tap_repo}" 2>&1)"
    rc=$?
    set -e

    if [[ "${rc}" -eq 0 ]]; then
      if [[ -z "${output}" ]]; then
        echo "No tap PR checks configured; skipping check watch."
        return 0
      fi
      echo "Watching tap PR checks (${pr_url})..."
      if gh pr checks "${pr_number}" --repo "${tap_repo}" --watch --fail-fast; then
        return 0
      fi
      if (( attempt < attempts )); then
        echo "Tap PR checks failed; retrying (${attempt}/${attempts})..." >&2
        sleep "${interval}"
        continue
      fi
      echo "error: tap PR checks failed: ${pr_url}" >&2
      return 1
    fi

    if echo "${output}" | grep -qi "no checks reported"; then
      echo "No tap PR checks configured; skipping check watch."
      return 0
    fi

    if (( attempt < attempts )); then
      echo "Could not read tap PR checks; retrying (${attempt}/${attempts})..." >&2
      sleep "${interval}"
    else
      echo "${output}" >&2
      echo "error: tap PR checks failed: ${pr_url}" >&2
      return 1
    fi
  done

  return 1
}

release_lib_confirm() {
  local prompt="$1"

  if [[ "${YES:-0}" == "1" || "${RUSTY_JACK_RELEASE_YES:-0}" == "1" ]]; then
    return 0
  fi
  if [[ ! -t 0 ]]; then
    echo "error: ${prompt} (not a TTY; set YES=1 to confirm)" >&2
    return 1
  fi

  local reply
  read -r -p "${prompt} [y/N] " reply
  [[ "${reply}" =~ ^[Yy]([Ee][Ss])?$ ]]
}

# Wait for required PR checks, then squash-merge (used by do-release and tap publish).
release_lib_merge_pr() {
  local repo="$1"
  local pr_url="$2"
  local label="${3:-PR}"
  local pr_number state

  if [[ -z "${pr_url}" ]]; then
    return 0
  fi

  if ! pr_number="$(gh pr view "${pr_url}" --repo "${repo}" --json number --jq .number 2>/dev/null)"; then
    echo "error: could not read ${label} number: ${pr_url}" >&2
    return 1
  fi

  if ! state="$(gh pr view "${pr_number}" --repo "${repo}" --json state --jq .state 2>/dev/null)"; then
    echo "error: could not read ${label} state: ${pr_url}" >&2
    return 1
  fi
  if [[ "${state}" == "MERGED" ]]; then
    echo "${label} already merged."
    return 0
  fi
  if [[ "${state}" != "OPEN" ]]; then
    echo "error: ${label} is ${state}, expected OPEN (${pr_url})" >&2
    return 1
  fi

  if ! release_lib_wait_for_tap_pr_checks "${repo}" "${pr_number}" "${pr_url}"; then
    return 1
  fi

  echo "Merging ${label}..."
  if ! gh pr merge "${pr_number}" --repo "${repo}" --squash --delete-branch; then
    echo "error: could not merge ${label}: ${pr_url}" >&2
    return 1
  fi

  if ! state="$(gh pr view "${pr_number}" --repo "${repo}" --json state --jq .state 2>/dev/null)"; then
    echo "error: could not verify ${label} merge: ${pr_url}" >&2
    return 1
  fi
  if [[ "${state}" != "MERGED" ]]; then
    echo "error: ${label} is ${state} after merge attempt (${pr_url})" >&2
    return 1
  fi

  echo "${label} merged."
  return 0
}

# Block until a GitHub PR merges (polls state; does not enable auto-merge).
release_lib_wait_for_pr_merge() {
  local repo="$1"
  local pr_url="$2"
  local label="${3:-PR}"
  local timeout_secs="${4:-${RUSTY_JACK_RELEASE_PR_MERGE_TIMEOUT_SECS:-86400}}"
  local interval=15
  local start state pr_number view_attempts=3 view_attempt

  if [[ -z "${pr_url}" ]]; then
    return 0
  fi

  for ((view_attempt = 1; view_attempt <= view_attempts; view_attempt++)); do
    if pr_number="$(gh pr view "${pr_url}" --repo "${repo}" --json number --jq .number 2>/dev/null)"; then
      break
    fi
    if (( view_attempt < view_attempts )); then
      echo "Could not read ${label} metadata; retrying (${view_attempt}/${view_attempts})..." >&2
      sleep 5
    else
      echo "error: could not read ${label} metadata: ${pr_url}" >&2
      return 1
    fi
  done

  for ((view_attempt = 1; view_attempt <= view_attempts; view_attempt++)); do
    if state="$(gh pr view "${pr_number}" --repo "${repo}" --json state --jq .state 2>/dev/null)"; then
      break
    fi
    if (( view_attempt < view_attempts )); then
      echo "Could not read ${label} state; retrying (${view_attempt}/${view_attempts})..." >&2
      sleep 5
    else
      echo "error: could not read ${label} state: ${pr_url}" >&2
      return 1
    fi
  done

  if [[ "${state}" == "MERGED" ]]; then
    echo "${label} already merged."
    return 0
  fi
  if [[ "${state}" != "OPEN" ]]; then
    echo "error: ${label} is ${state}, expected OPEN or MERGED (${pr_url})" >&2
    return 1
  fi

  echo "Waiting for ${label} to merge on GitHub:"
  echo "  ${pr_url}"
  start="${SECONDS}"
  while (( SECONDS - start < timeout_secs )); do
    if ! state="$(gh pr view "${pr_number}" --repo "${repo}" --json state --jq .state 2>/dev/null)"; then
      echo "Could not read ${label} state; retrying..." >&2
      sleep "${interval}"
      continue
    fi
    if [[ "${state}" == "MERGED" ]]; then
      echo "${label} merged."
      return 0
    fi
    if [[ "${state}" != "OPEN" ]]; then
      echo "error: ${label} is ${state}, expected MERGED (${pr_url})" >&2
      return 1
    fi
    sleep "${interval}"
  done

  echo "error: timed out after ${timeout_secs}s waiting for ${label} merge: ${pr_url}" >&2
  return 1
}

release_lib_show_pr_diff() {
  local repo="$1"
  local pr_url="$2"

  echo "=== Release PR diff ==="
  if [[ -t 1 ]]; then
    gh pr diff "${pr_url}" --repo "${repo}" --color=always | "${PAGER:-less}" -R
  else
    gh pr diff "${pr_url}" --repo "${repo}"
  fi
}

release_lib_verify_published_release() {
  local repo="$1"
  local tap_repo="$2"
  local version="$3"
  local tag formula tag_fragment

  if ! tag="$(release_lib_resolve_release_tag "${repo}" "${version}")"; then
    echo "error: GitHub release missing for version ${version}" >&2
    return 1
  fi
  if ! gh release view "${tag}" --repo "${repo}" >/dev/null 2>&1; then
    echo "error: could not read GitHub release ${tag}" >&2
    return 1
  fi
  echo "Verified GitHub release: ${tag}"

  if ! formula="$(gh api "repos/${tap_repo}/contents/Formula/rusty-jack.rb?ref=main" --jq -r .content 2>/dev/null)"; then
    echo "error: could not read Homebrew formula from ${tap_repo}" >&2
    return 1
  fi
  formula="$(printf '%s' "${formula}" | base64 -d)"
  tag_fragment="${tag}"
  if ! grep -Fq "${tag_fragment}" <<<"${formula}"; then
    tag_fragment="refs/tags/${tag}"
    if ! grep -Fq "${tag_fragment}" <<<"${formula}"; then
      echo "error: tap formula on ${tap_repo} main does not reference ${tag}" >&2
      return 1
    fi
  fi
  echo "Verified Homebrew tap formula references ${tag}"
}

# Block until the tap PR merges (after CI passes and auto-merge runs).
release_lib_wait_for_tap_pr_merge() {
  local tap_repo="$1"
  local pr_url="$2"
  local pr_number state interval=15
  local timeout_secs="${RUSTY_JACK_TAP_MERGE_TIMEOUT_SECS:-1800}"
  local start view_attempts=3 view_attempt

  if [[ -z "${pr_url}" ]]; then
    return 0
  fi

  for ((view_attempt = 1; view_attempt <= view_attempts; view_attempt++)); do
    if pr_number="$(gh pr view "${pr_url}" --repo "${tap_repo}" --json number --jq .number 2>/dev/null)"; then
      break
    fi
    if (( view_attempt < view_attempts )); then
      echo "Could not read tap PR metadata; retrying (${view_attempt}/${view_attempts})..." >&2
      sleep 5
    else
      echo "error: could not read tap PR metadata: ${pr_url}" >&2
      return 1
    fi
  done

  for ((view_attempt = 1; view_attempt <= view_attempts; view_attempt++)); do
    if state="$(gh pr view "${pr_number}" --repo "${tap_repo}" --json state --jq .state 2>/dev/null)"; then
      break
    fi
    if (( view_attempt < view_attempts )); then
      echo "Could not read tap PR state; retrying (${view_attempt}/${view_attempts})..." >&2
      sleep 5
    else
      echo "error: could not read tap PR state: ${pr_url}" >&2
      return 1
    fi
  done

  if [[ "${state}" == "MERGED" ]]; then
    return 0
  fi

  if ! release_lib_wait_for_tap_pr_checks "${tap_repo}" "${pr_number}" "${pr_url}"; then
    return 1
  fi

  echo "Waiting for tap PR to merge: ${pr_url}"
  start="${SECONDS}"
  while (( SECONDS - start < timeout_secs )); do
    if release_lib_pr_checks_blocking_merge "${tap_repo}" "${pr_number}" "${pr_url}"; then
      return 1
    fi
    if ! state="$(gh pr view "${pr_number}" --repo "${tap_repo}" --json state --jq .state 2>/dev/null)"; then
      echo "Could not read tap PR state; retrying..." >&2
      sleep "${interval}"
      continue
    fi
    if [[ "${state}" == "MERGED" ]]; then
      return 0
    fi
    if [[ "${state}" != "OPEN" ]]; then
      echo "error: tap PR is ${state}, expected MERGED (${pr_url})" >&2
      return 1
    fi
    sleep "${interval}"
  done

  echo "error: timed out after ${timeout_secs}s waiting for tap PR merge: ${pr_url}" >&2
  return 1
}
